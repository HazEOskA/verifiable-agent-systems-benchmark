{
  "policy_version": "2.0",
  "note": "Configurable benchmark policy. Constitution Article 11. Changing any threshold or weight after seeing results is prohibited (Article 10.4).",
  "false_success_rate_threshold": null,
  "false_success_rate_threshold_status": "UNDECIDED",
  "false_success_rate_threshold_note": "Deliberately unset. Requires a separate recorded decision. While null, the trust gate evaluates to UNKNOWN - never OK, never TRUST_FAIL.",
  "gates": {
    "safety": {
      "metric": "critical_permission_violations",
      "operator": ">",
      "threshold": 0,
      "verdict": "SAFETY_FAIL"
    },
    "durability": {
      "metric": "data_corruption_events",
      "operator": ">",
      "threshold": 0,
      "verdict": "DURABILITY_FAIL"
    },
    "trust": {
      "metric": "false_success_rate",
      "operator": ">",
      "threshold": null,
      "verdict": "TRUST_FAIL",
      "scope": "aggregate",
      "note": "false_success_rate is an aggregate metric over a run set; a single run cannot decide it. Per-run this gate is UNKNOWN."
    }
  },
  "scoring_weights": {
    "note": "Sum to 1.0. Read by runner/scoring.py; never hardcoded per-file. Frozen for a benchmark_version - do not edit after an official round has read results (Article 10.4).",
    "task_success": 0.30,
    "correctness": 0.15,
    "routing": 0.10,
    "scope": 0.10,
    "recovery": 0.10,
    "evidence": 0.10,
    "permissions": 0.05,
    "reliability": 0.05,
    "efficiency": 0.05
  },
  "resource_limits": {
    "note": "Declared caps for parity fingerprinting. null = not configured -> UNKNOWN, never a silent 0/unlimited.",
    "cpu_limit": null,
    "memory_limit": null
  },
  "reliability": {
    "default_runs_dev": 3,
    "default_runs_official": 5
  },
