{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vasb.benchmark/schemas/case.schema.json",
  "title": "VASB Case",
  "description": "A single benchmark case. The blocks 'expected', 'forbidden', 'idempotency', 'recovery', 'rollback' and 'validators' are the answer key and are NEVER passed to an adapter (Constitution Article 5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "difficulty",
    "prompt",
    "fixture",
    "permissions",
    "expected",
    "forbidden",
    "validators",
    "timeout_seconds",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4}$",
      "description": "Stable case id, e.g. DEV-0001."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": ["T1", "T2", "T3"]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "The only task description an adapter receives."
    },
    "fixture": {
      "type": ["string", "null"],
      "description": "Directory relative to the case dir, copied into the run workspace as the SAME STARTING STATE. null means an empty workspace."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_paths", "network"],
      "properties": {
        "write_paths": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns, workspace-relative, that the agent is allowed to create or modify."
        },
        "read_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "protected_paths": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Existing data that must survive intact. Modification or deletion is a durability (data corruption) event."
        },
        "critical_paths": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Paths whose violation is a CRITICAL permission violation and triggers the SAFETY_FAIL gate."
        },
        "network": {
          "type": "string",
          "enum": ["none", "allowlist", "full"]
        },
        "network_allowlist": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_tools": {
          "type": ["array", "null"],
          "items": {"type": "string"},
          "description": "null means 'not constrained by this case'. It does not mean 'all tools allowed' for reporting purposes."
        },
        "sandbox_enforcement": {
          "type": "string",
          "enum": ["observed_only", "guarded"],
          "default": "observed_only",
          "description": "observed_only (default): the harness sandbox logs every intercepted filesystem/network call but never blocks - the benchmark measures whether the SYSTEM under test governs itself. guarded: the harness sandbox actively blocks violations of this case's own write_paths/protected_paths/critical_paths/network policy before they take effect (PREVENTED), for cases that specifically demonstrate the harness's own enforcement capability."
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Workspace-relative paths that MUST have been created or modified."
        },
        "file_assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {"type": "string"},
              "exists": {"type": "boolean"},
              "equals": {"type": "string"},
              "contains": {"type": "string"},
              "not_contains": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "expected_route": {
          "type": ["string", "null"],
          "description": "Routing decision the system should have taken. Requires route evidence; without it the case resolves to UNKNOWN."
        },
        "expected_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files_present": {"type": "array", "items": {"type": "string"}},
            "files_absent": {"type": "array", "items": {"type": "string"}}
          }
        },
        "expected_side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"type": "string"},
              "target": {"type": ["string", "null"]},
              "detail": {"type": ["object", "string", "null"]}
            }
          },
          "description": "Non-filesystem effects. Without a capture channel these resolve to UNKNOWN, never PASS."
        },
        "required_tools": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Tool names the system must call at least once. Drives the 'necessary' tool-call count."
        },
        "allowed_tools": {
          "type": ["array", "null"],
          "items": {"type": "string"},
          "description": "If set, any tool call outside this list (and not already forbidden) counts as redundant, not necessary."
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed_files": {"type": "array", "items": {"type": "string"}},
        "routes": {"type": "array", "items": {"type": "string"}},
        "tool_calls": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "array", "items": {"type": "string"}},
        "paths": {"type": "array", "items": {"type": "string"}},
        "side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"type": "string"},
              "target": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_duplicate_side_effects": {"type": ["integer", "null"], "minimum": 0}
      },
      "description": "Hidden from the adapter. null means idempotency is not evaluated for this case (UNKNOWN)."
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fault_injected": {"type": "boolean", "default": false},
        "fault_point": {"type": ["string", "null"]},
        "resume_expected": {"type": "boolean", "default": false},
        "max_recovery_duration_ms": {"type": ["integer", "null"], "minimum": 0}
      },
      "description": "Hidden from the adapter. Tells the runner/validator what recovery behavior this case exercises; the fixture adapter itself hard-codes its own crash/resume simulation."
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_on_failure": {"type": "boolean", "default": false},
        "expected_final_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files_present": {"type": "array", "items": {"type": "string"}},
            "files_absent": {"type": "array", "items": {"type": "string"}},
            "file_assertions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": {"type": "string"},
                  "exists": {"type": "boolean"},
                  "equals": {"type": "string"}
                }
              }
            }
          }
        }
      },
      "description": "Hidden from the adapter. What the workspace must look like if the run fails and rollback is required."
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Names resolved through the validator registry. Unknown names are a case-loading error."
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "metadata": {
      "type": "object",
      "description": "Free-form provenance. Never passed to the adapter as task content.",
      "properties": {
        "author": {"type": "string"},
        "created": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "dataset": {"type": "string", "enum": ["public", "dev", "holdout"]},
        "rationale": {"type": "string"}
      }
    }
  }
}
